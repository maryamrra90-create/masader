# Copy to .env and fill in. Never commit .env (it is in .gitignore).
ENV=dev
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgresql://masader:change-me@postgres:5432/masader
REDIS_URL=redis://redis:6379/0
# HMAC pepper for API keys: a long random string, e.g. `python -c "import secrets; print(secrets.token_urlsafe(48))"`
KEY_PEPPER=
# simulated = heuristic simulator, no key needed (outputs are NOT model outputs); live = Anthropic API
MODEL_MODE=simulated
# Only for MODEL_MODE=live. Set it here or in your secret manager; never paste it into code, chat or issues.
ANTHROPIC_API_KEY=
# hashing (offline, default) or fastembed (downloads paraphrase-multilingual-MiniLM-L12-v2 on first use)
EMBEDDER=hashing
OBJECT_STORE=local
OBJECT_DIR=/data/objects
# 1 = connectors call the real GDELT, RSS and World Bank endpoints on a schedule (needs outbound network)
LIVE_SOURCES=0
# simulated model latency: stage budget in minutes x this many seconds (0 = instant)
SIM_LATENCY_SCALE=0
ADMISSION_MAX_ACTIVE=6
